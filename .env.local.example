NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK (server-side auth verification)
# Generate from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=your_service_account@your_project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Encryption salt for broker token encryption (AES-256-GCM + PBKDF2)
# Generate a random string: openssl rand -hex 16
NEXT_PUBLIC_CRYPTO_SALT=your_random_salt_here

# Vercel KV (shared rate limiting + last-known-good price/FX cache) — optional
KV_REST_API_URL=your_kv_rest_url
KV_REST_API_TOKEN=your_kv_rest_token

# Month-end finance reminder (optional — silently off without these)
# CRON_SECRET: any random string; Vercel Cron sends it as Authorization: Bearer.
#   Generate: openssl rand -hex 24. Set the SAME value in Vercel env vars.
# SMTP_*: credentials of a mailbox on OUR domain — no third-party sending service.
#   Free option: Zoho Mail free plan → add the chispu.xyz domain (MX + SPF + DKIM
#   DNS records) → create reminders@chispu.xyz → generate an app password
#   (Zoho account → Security → App Passwords) and use it as SMTP_PASS.
#   Any other SMTP host works the same way (Google Workspace, Fastmail, ...).
# SMTP_FROM: to send as a no-reply, point it at an address that EXISTS on the
#   authenticated mailbox (an ALIAS of the same user). Nearly every SMTP host
#   rejects or rewrites a From the account does not own.
# SMTP_REPLY_TO: leave unset for a no-reply. Set it only if replies should land
#   somewhere real; the body already says the address is not read.
CRON_SECRET=your_random_cron_secret
SMTP_HOST=smtp.zoho.com
SMTP_USER=reminders@chispu.xyz
SMTP_PASS=your_app_password
# SMTP_PORT=465
# SMTP_FROM="Chispudo <noreply@chispu.xyz>"
# SMTP_REPLY_TO=

# Auto-captured expenses (iPhone Shortcut + forwarded bank alerts) — optional
#
# Path A (Shortcut) needs NOTHING here: it authenticates with an ingest token you
# generate from Settings → Automático.
#
# Path C (forwarded email) polls ONE mailbox over IMAP. It reuses the mailbox
# that ALREADY sends the reminder and brief emails — reminders@chispu.xyz in
# Zoho — instead of creating a second one. Nothing about the routing depends on
# the local part: the user is identified by the +<token> label, so
# reminders+<token>@chispu.xyz works with the mailbox exactly as it is.
#
# What that buys: no new mailbox, no catch-all forwarding, no second provider,
# and the SAME app password already issued for SMTP can serve IMAP.
#   1. Zoho -> Security -> App Passwords: reuse the SMTP one or issue another.
#   2. Set IMAP_HOST / IMAP_USER / IMAP_PASS below (IMAP_USER is the mailbox).
#   3. NEXT_PUBLIC_INGEST_EMAIL is what Settings SHOWS the user, so it must be
#      the address their mail rule will forward to.
#
# Optional but tidier: add a Zoho filter that moves mail addressed to
# reminders+* into a folder (say "Gastos") and set IMAP_MAILBOX to it. Then the
# sweep never even looks at the inbox where bounces land. Without it the sweep
# still only ever touches messages carrying an ingest token — a message with no
# token is left unread exactly as it was found, so bounces stay visible.
#
# Without IMAP_HOST/USER/PASS the sweep is a silent no-op and Settings hides the
# email option. The daily sweep rides in /api/cron/notifications (the Hobby tier
# allows 2 crons), so CRON_SECRET gates it too.
IMAP_HOST=imap.zoho.com
IMAP_USER=reminders@chispu.xyz
IMAP_PASS=your_zoho_app_password
# IMAP_PORT=993
# IMAP_MAILBOX=INBOX
NEXT_PUBLIC_INGEST_EMAIL=reminders@chispu.xyz
