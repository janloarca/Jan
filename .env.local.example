NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK (server-side auth verification)
# Generate from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=your_service_account@your_project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Encryption salt for broker token encryption (AES-256-GCM + PBKDF2)
# Generate a random string: openssl rand -hex 16
NEXT_PUBLIC_CRYPTO_SALT=your_random_salt_here

# Vercel KV (shared rate limiting + last-known-good price/FX cache) — optional
KV_REST_API_URL=your_kv_rest_url
KV_REST_API_TOKEN=your_kv_rest_token

# Month-end finance reminder (optional — silently off without these)
# CRON_SECRET: any random string; Vercel Cron sends it as Authorization: Bearer.
#   Generate: openssl rand -hex 24. Set the SAME value in Vercel env vars.
# SMTP_*: credentials of a mailbox on OUR domain — no third-party sending service.
#   Free option: Zoho Mail free plan → add the chispu.xyz domain (MX + SPF + DKIM
#   DNS records) → create reminders@chispu.xyz → generate an app password
#   (Zoho account → Security → App Passwords) and use it as SMTP_PASS.
#   Any other SMTP host works the same way (Google Workspace, Fastmail, ...).
# SMTP_FROM: to send as a no-reply, point it at an address that EXISTS on the
#   authenticated mailbox (an ALIAS of the same user). Nearly every SMTP host
#   rejects or rewrites a From the account does not own.
# SMTP_REPLY_TO: leave unset for a no-reply. Set it only if replies should land
#   somewhere real; the body already says the address is not read.
CRON_SECRET=your_random_cron_secret
SMTP_HOST=smtp.zoho.com
SMTP_USER=reminders@chispu.xyz
SMTP_PASS=your_app_password
# SMTP_PORT=465
# SMTP_FROM="Chispudo <noreply@chispu.xyz>"
# SMTP_REPLY_TO=
